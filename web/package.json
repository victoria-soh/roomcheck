{
  "name": "roomcheck-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "test:demo": "vite build && playwright test -c playwright.demo.config.ts",
    "shots": "vite build && playwright test -c playwright.shots.config.ts",
    "shots:gallery": "playwright test -c playwright.gallery.config.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/saira": "5.3.0",
    "@tanstack/react-query": "5.105.3",
    "i18next": "26.7.1",
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.11",
    "react-is": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
