# RoomCheck configuration. Copy to .env and fill in; .env is never committed.
# Real environment variables override values here. These four keys are the only ones read
# (app/config.py); every one is optional.

# Anthropic API key for AI explanations (e.g. sk-ant-...). Empty: the standard template text.
ANTHROPIC_API_KEY=

# Model name for AI explanations. Leave empty to use the default set in app/config.py.
ANTHROPIC_MODEL=

# NVD API key for faster known-issue (CVE) lookups (50 instead of 5 requests per 30 s).
# Empty: the slower public rate.
NVD_API_KEY=

# RFC 3161 timestamp authority for the handover report. Leave empty to use this default.
TSA_URL=https://freetsa.org/tsr
